# Settings of your installation. Copy to <root>/secrets/trace.env on the server
# (mode 600, outside the synced tree) and put in your own values; deploy.sh
# passes the file to Docker Compose.

# The origin your reverse proxy serves Trace on: no path, no trailing slash.
TRACE_ORIGIN=https://trace.example.com

# The issuer URL of your OIDC provider, exactly as it announces it.
OIDC_ISSUER=https://id.example.com/realms/example
