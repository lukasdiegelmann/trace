# Monolithium is a component library from a private npm registry; installing
# it needs two env vars:
#   MONOCIRCUIT_NPM_REGISTRY  the registry URL without "https://", with a
#                             trailing slash (e.g. registry.example.com/npm/)
#   MONOCIRCUIT_NPM_TOKEN     a read token for it; never commit a token
@monocircuit:registry=https://${MONOCIRCUIT_NPM_REGISTRY}
//${MONOCIRCUIT_NPM_REGISTRY}:_authToken=${MONOCIRCUIT_NPM_TOKEN}
